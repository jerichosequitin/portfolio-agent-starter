# The portfolio works without chat. Enable it only after configuring a provider
# budget and a public rate limit for /api/chat.
CHAT_ENABLED=false
CHAT_PROVIDER=gateway
AI_MODEL=openai/gpt-4.1-mini

# Required for local or non-Vercel AI Gateway use. Vercel deployments can use OIDC.
AI_GATEWAY_API_KEY=

# Required only when CHAT_PROVIDER=openrouter.
OPENROUTER_API_KEY=
